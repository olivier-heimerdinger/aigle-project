# ==============================================================================
# FICHIER D'EXEMPLE .ENV — AIGLE SAAS SERVER
# Copiez ce fichier vers .env (cp .env.example .env) et personnalisez les secrets
# ==============================================================================

# Domaines Traefik
AIGLE_APP_DOMAIN=aigle.heimerdinger.studio
AIGLE_AUTH_DOMAIN=aigle-auth.heimerdinger.studio

# Base de données PostgreSQL 16
POSTGRES_USER=aigle
POSTGRES_PASSWORD=ChangeMe_Strong_Postgres_Password_2026!
POSTGRES_DB=aigle_saas

# Mode d'authentification ("authelia" en production derrière Traefik, "dev" en test local)
AIGLE_AUTH_MODE=authelia

# Groupes Authelia mappés vers les rôles RBAC d'Aigle
AIGLE_ADMIN_GROUPS=admins,superadmin,aigle-admin
AIGLE_MANAGER_GROUPS=managers,aigle-manager

# Optionnel : Secret partagé entre Traefik et Aigle pour empêcher tout spoofing d'en-têtes
AIGLE_TRUSTED_PROXY_SECRET=

